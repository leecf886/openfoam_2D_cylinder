viscosityModel  constant;

// rho = 1000 kg/m3, dynamic viscosity mu = 0.001 Pa.s.
// The incompressible solver uses kinematic viscosity nu = mu/rho.
nu              [0 2 -1 0 0 0 0] 1e-06;
